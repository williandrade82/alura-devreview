SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key do projeto (Settings > API Keys): ignora RLS e permite escrita. Nunca versionar.
SUPABASE_SERVICE_KEY=

# Opcional: token do GitHub (permissão de escrita em Pull requests) para o record_review
# publicar a revisão como comentário no PR. Sem ele, a revisão só é gravada no histórico.
# Prefira defini-lo como variável de ambiente do usuário e repassá-lo no env do server em .mcp.json.
# GITHUB_PAT=

# Repositórios onde o record_review pode PUBLICAR comentários (separados por vírgula):
# "dono/repo" ou "dono/*". Sem esta variável nada é publicado: o destino vem do LLM, que lê
# conteúdo não confiável (descrição e diff de PRs).
# GITHUB_ALLOWED_REPOS=dono/repo
