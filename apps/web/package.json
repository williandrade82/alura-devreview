{
  "name": "@devreview/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src/components/stats src/lib/stats.ts src/lib/stats.test.ts src/lib/statsGuards.ts src/lib/statsGuards.test.ts src/pages/StatsPage.tsx src/store/slices/statsSlice.ts",
    "format:check": "prettier --check src/components/stats src/lib/stats.ts src/lib/stats.test.ts src/lib/statsGuards.ts src/lib/statsGuards.test.ts src/pages/StatsPage.tsx src/store/slices/statsSlice.ts",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.3.0",
    "@supabase/supabase-js": "^2.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
